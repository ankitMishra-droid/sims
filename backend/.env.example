# Application Configuration
APP_NAME=StockSangati
APP_ENV=development
DEBUG=False

# Database Configuration
# SQLite local default:
DATABASE_URL=sqlite:///./inventory.db
# Supabase / PostgreSQL production (use Session Pooler or Direct URI; psycopg2 driver is normalized automatically):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Connection Pool Settings (PostgreSQL only)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=300
# DB_USE_NULL_POOL=false
# DB_SSLMODE=require

# Security & JWT Authentication
JWT_SECRET_KEY=generate-a-secure-random-256-bit-key-using-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated allowed browser origins for production CORS (never use '*')
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# FRONTEND_URL=https://your-vercel-app.vercel.app

# Machine Learning Parameters
DEFAULT_SERVICE_LEVEL=0.95
DEFAULT_FORECAST_HORIZON_DAYS=30
MODEL_ARTIFACTS_DIR=./artifacts/models

# Phase 7: Gemini LLM, Embeddings & Qdrant Vector Infrastructure (keep secrets out of VCS)
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_LLM_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536
GEMINI_EMBEDDING_NORMALIZE=true
GEMINI_EMBEDDING_VERSION=v1
GEMINI_TIMEOUT_SECONDS=20
GEMINI_OVERALL_DEADLINE_SECONDS=25
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_SECONDS=1.0
GEMINI_RETRY_MAX_SECONDS=12.0
GEMINI_CIRCUIT_BREAKER_ENABLED=true
GEMINI_CIRCUIT_FAILURE_THRESHOLD=4
GEMINI_CIRCUIT_RECOVERY_SECONDS=30
GEMINI_MAX_CONCURRENT_REQUESTS=8
GEMINI_DEFAULT_TEMPERATURE=0.2
GEMINI_DEFAULT_MAX_OUTPUT_TOKENS=1024

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=sims_kb
QDRANT_COLLECTION_VERSION=v1
QDRANT_COLLECTION_NAME=
QDRANT_TIMEOUT_SECONDS=15
QDRANT_MAX_RETRIES=3
QDRANT_PREFER_GRPC=false
AI_STRICT_STARTUP=false

# Phase 8: RAG Ingestion & Retrieval Tuning
AI_UPLOAD_DIR=./ai_uploads
AI_MAX_DOCUMENT_MB=15
AI_MAX_PDF_PAGES=150
AI_CHUNK_SIZE_CHARS=900
AI_CHUNK_OVERLAP_CHARS=120
AI_RETRIEVAL_TOP_K=5
AI_RETRIEVAL_MIN_SCORE=0.12
AI_MAX_CONVERSATION_TURNS=8

# Phase 9: AI Credit System, Metering & Quota Controls (configure approved commercial rates)
GEMINI_QUOTA_COOLDOWN_SECONDS=300
AI_CREDITS_ENFORCED=true
AI_INITIAL_GRANT_APPROVED=true
AI_INITIAL_GRANT_CREDITS=3000
AI_DEFAULT_PLAN_TIER=standard
AI_DEFAULT_RPM_LIMIT=20
AI_DEFAULT_DAILY_REQUEST_LIMIT=500
AI_DEFAULT_DAILY_TOKEN_LIMIT=250000
AI_DEFAULT_MAX_CREDITS_PER_OP=50
AI_DEFAULT_MAX_CONCURRENT_REQUESTS=5
AI_PRICING_VERSION=2026-11-phase9-v1
AI_RATES_APPROVED=false
# AI_PRICE_CHAT_BASE=0.100
# AI_PRICE_CHAT_INPUT_PER_1K=0.500
# AI_PRICE_CHAT_OUTPUT_PER_1K=1.500
# AI_PRICE_EMBED_BASE=0.010
# AI_PRICE_EMBED_PER_1K=0.100
# AI_PRICE_INGEST_PER_CHUNK=0.050
