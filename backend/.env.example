# Application Configuration
APP_NAME=StockSangati
APP_ENV=development
DEBUG=False

# Database Configuration
# SQLite local default:
DATABASE_URL=sqlite:///./inventory.db
# Supabase / PostgreSQL production (use Session Pooler or Direct URI; psycopg2 driver is normalized automatically):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Connection Pool Settings (PostgreSQL only)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=300
# DB_USE_NULL_POOL=false
# DB_SSLMODE=require

# Security & JWT Authentication
JWT_SECRET_KEY=generate-a-secure-random-256-bit-key-using-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Machine Learning Parameters
DEFAULT_SERVICE_LEVEL=0.95
DEFAULT_FORECAST_HORIZON_DAYS=30
MODEL_ARTIFACTS_DIR=./artifacts/models
